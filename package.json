{
  "name": "nsamble",
  "version": "0.0.0",
  "description": "A platform dedicated to the use of natural language for general purpose, parametric and 3d printer compatible 3d models to generate manufacturing prototypes and proof of concepts that would need a team to develop.",
  "keywords": [
    "mcp",
    "production",
    "prototype",
    "design"
  ],
  "homepage": "https://github.com/WeirdCatAFK/nsamble#readme",
  "bugs": {
    "url": "https://github.com/WeirdCatAFK/nsamble/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WeirdCatAFK/nsamble.git"
  },
  "license": "MIT",
  "author": "Daniel Pineda Torres",
  "type": "module",
  "main": "main.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "node --watch main.js",
    "start": "node main.js",
    "prisma:generate": "prisma generate --config prisma7.config.ts",
    "prisma:validate": "prisma validate --config prisma7.config.ts",
    "db:migrate": "prisma migrate deploy --config prisma7.config.ts",
    "db:seed": "node prisma/seed-models.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.922.0",
    "@aws-sdk/lib-storage": "^3.922.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "openai": "^7.44.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@prisma/prisma7": "^7.10.1"
  },
  "overrides": {
    "bowser": "2.14.1"
  }
}
